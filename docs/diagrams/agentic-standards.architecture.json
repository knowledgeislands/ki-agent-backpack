  "cards": [
    {
      "dot": "cyan",
      "title": "The standards",
      "items": [
        "MCP: an agent to its tools and data (revision 2026-07-28)",
        "ACP: an editor drives an agent over stdio (release of 18 November 2026)",
        "AHP: many clients share an agent host's sessions; it sits above ACP (1.1.0)",
        "A2A: an agent to an opaque remote agent, found by its Agent Card (1.0.1)"
      ]
    },
    {
      "dot": "amber",
      "title": "Ways into a running session",
      "items": [
        "Channel: an MCP server pushing outside events into a running session, as Telegram's does",
        "Cross-session messaging: one session's plain-text message to a peer",
        "Integration, not drawn: starts a new session from outside; its card is pending",
        "AHP's channels are another sense: a subscription to one resource's state"
      ]
    },
    {
      "dot": "violet",
      "title": "Agent kinds",
      "items": [
        "Subagent: inside a session, in a thread of its own, under its agent",
        "Peer: another session in the same system, reached by cross-session messaging",
        "Remote agent: an agent in another system, opaque, reached over A2A"
      ]
    },
    {
      "dot": "emerald",
      "title": "Our conventions",
      "items": [
        "Sessions meet in the Cairn store, each message a file they read; nothing is pushed, so it is not a channel",
        "A session on another rig is a peer in the same system, not a remote agent"
      ]
    }
  ]
